# secrets and private (copyrighted / restricted) artifacts — never commit
.env
*.key
.cache/
private/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# logs and regenerable outputs
logs/
outputs/
runs/
snapshots/
tmp/

# OS
.DS_Store

# collaboration surface (published as an artifact)
docs/decision-board.html

# eval records + regenerable analysis outputs (large; reproduce with the pipeline)
results/
*.bak
# trained adapters / weights live on HF, never in git
*.safetensors
*.bin
# datasets / corpora are regenerated or fetched, not committed
outputs/discourse_v2/
training*/

# built reports (regenerable; contain the incident narrative) — keep out of a shareable repo
docs/pilot_writeup.html
docs/pilot_writeup.docx
